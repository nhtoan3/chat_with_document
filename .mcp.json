{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium",
        "--isolated",
        "--output-dir",
        "test_reports/_mcp"
      ]
    },
    "agent-browser": {
      "type": "stdio",
      "command": "agent-browser",
      "args": [
        "mcp"
      ]
    },
    "vibe_kanban": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "vibe-kanban@latest",
        "--mcp"
      ]
    }
  }
}
