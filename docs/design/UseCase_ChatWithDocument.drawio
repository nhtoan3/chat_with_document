x="300" y="475" width="170" height="64" as="geometry"/></mxCell><mxCell id="uc14" value="&lt;b&gt;UC-14&lt;/b&gt;&lt;br&gt;Đánh giá câu trả lời" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" parent="1" vertex="1"><mxGeometry x="760" y="475" width="170" height="64" as="geometry"/></mxCell><mxCell id="uc15" value="&lt;b&gt;UC-15&lt;/b&gt;&lt;br&gt;Dừng tạo câu trả lời" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1000" y="475" width="170" height="64" as="geometry"/></mxCell><mxCell id="uc16" value="&lt;b&gt;UC-16&lt;/b&gt;&lt;br&gt;Bắt đầu hội thoại mới" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1"><mxGeometry x="320" y="640" width="170" height="64" as="geometry"/></mxCell><mxCell id="uc17" value="&lt;b&gt;UC-17&lt;/b&gt;&lt;br&gt;Hỏi câu nối tiếp" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1"><mxGeometry x="540" y="640" width="190" height="64" as="geometry"/></mxCell><mxCell id="uc18" value="&lt;b&gt;UC-18&lt;/b&gt;&lt;br&gt;Xem lịch sử hội thoại" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1"><mxGeometry x="820" y="640" width="190" height="64" as="geometry"/></mxCell><mxCell id="uc04" value="&lt;b&gt;UC-04&lt;/b&gt;&lt;br&gt;Tải lên tài liệu PDF" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" parent="1" vertex="1"><mxGeometry x="340" y="815" width="170" height="64" as="geometry"/></mxCell><mxCell id="uc05" value="&lt;b&gt;UC-05&lt;/b&gt;&lt;br&gt;Kiểm tra tính hợp lệ của tệp" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" parent="1" vertex="1"><mxGeometry x="620" y="800" width="190" height="64" as="geometry"/></mxCell><mxCell id="uc09" value="&lt;b&gt;UC-09&lt;/b&