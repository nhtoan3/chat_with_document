<mxfile host="app.diagrams.net" type="device"><diagram id="usecase" name="Use Case - Chat với tài liệu"><mxGraphModel dx="1600" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="Hệ thống «Chat với tài liệu» (MVP)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=16;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;spacingTop=6;" parent="1" vertex="1"><mxGeometry x="240" y="20" width="1260" height="1250" as="geometry"/></mxCell><mxCell id="pkg1" value="Truy cập &amp;amp; phân quyền (EP-01)" style="rounded=1;arcSize=3;dashed=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#8FA3BF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=3;fontSize=12;fontColor=#4A5A70;" parent="1" vertex="1"><mxGeometry x="280" y="60" width="1180" height="150" as="geometry"/></mxCell><mxCell id="pkg3" value="Hỏi đáp có trích dẫn (EP-03)" style="rounded=1;arcSize=3;dashed=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#8FA3BF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=3;fontSize=12;fontColor=#4A5A70;" parent="1" vertex="1"><mxGeometry x="280" y="240" width="1180" height="320" as="geometry"/></mxCell><mxCell id="pkg4" value="Hội thoại &amp;amp; lịch sử (EP-04)" style="rounded=1;arcSize=3;dashed=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#8FA3BF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=3;fontSize=12;fontColor=#4A5A70;" parent="1" vertex="1"><mxGeometry x="280" y="590" width="1180" height="150" as="geometry"/></mxCell><mxCell id="pkg2" value="Quản lý bộ tài liệu (EP-02)" style="rounded=1;arcSize=3;dashed=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#8FA3BF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=3;fontSize=12;fontColor=#4A5A70;" parent="1" vertex="1"