oundColor=#FFFFFF;" parent="1" edge="1" source="uc04" target="uc05"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_inc_04_09" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;strokeColor=#6C8EBF;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="uc04" target="uc09"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ext_12_11" value="«extend»&lt;br&gt;[không có căn cứ trong tài liệu]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;strokeColor=#B85450;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="uc12" target="uc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ext_15_11" value="«extend»&lt;br&gt;[người dùng bấm Dừng]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;strokeColor=#B85450;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="uc15" target="uc11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ext_13_10" value="«extend»&lt;br&gt;[chọn trích dẫn]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;strokeColor=#B85450;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="uc13" target="uc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ext_14_10" value="«extend»&lt;br&gt;[sau khi có câu trả lời]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;strokeColor=#B85450;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="uc14" target="uc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ext_08_04" value="«extend»&lt;br&gt;[tên tệp đã tồn tại]" style="endArrow=open;endSize=10;dashed=1;html=1;fontSize=11;strokeColor=#B85450;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="uc08" target="uc04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gen_17_10" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" parent="1" edge="1" source="uc17" target="uc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_bd" value="Chuyên viên BD&lt;br&gt;&lt;i&gt;(Member)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="370" width="34" height="64" as="geometry"/></mxCell><mxCell id="a_admin" value="Quản trị viên&lt;br&gt;&lt;i&gt;(Admin)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="990" width="34" height="64" as="geometry"/></mxCell><mxCell id="a_mgr" value="Quản lý" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="60" y="1165" width="34" height="64" as="geometry"/></mxCell><mxCell id="a_idp" value="«system»&lt;br&gt;Dịch vụ định danh&lt;br&gt;&lt;i&gt;(SSO — OQ-014)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="1590" y="100" width="34" height="64" as="geometry"/></mxCell><mxCell id="a_ai" value="«system»&lt;br&gt;Dịch vụ AI ngôn ngữ&lt;br&gt;&lt;i&gt;(DEP-001, OQ-008)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="1590" y="360" width="34" height="64" as="geometry"/></mxCell><mxCell id="g_admin_bd" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_admin" target="a_bd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_bd_uc01" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_bd" target="uc01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_bd_uc02" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_bd" target="uc02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_bd_uc10" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_bd" target="uc10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_bd_uc16" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_bd" target="uc16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_bd_uc18" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_bd" target="uc18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_bd_uc04" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_bd" target="uc04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_bd_uc06" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_bd" target="uc06"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_admin_uc07" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_admin" target="uc07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_admin_uc03" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_admin" target="uc03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_admin_uc19" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_admin" target="uc19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_mgr_uc19" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="a_mgr" target="uc19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="1262"/></Array></mxGeometry></mxCell><mxCell id="as_idp_uc01" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="uc01" target="a_idp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="as_ai_uc11" value="" style="endArrow=none;html=1;strokeColor=#333333;" parent="1" edge="1" source="uc11" target="a_ai"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note_trace" value="&lt;b&gt;Truy vết Use case → User story (PRD-CWD-001)&lt;/b&gt;&lt;br&gt;UC-01 → US-001 · UC-02 → US-001&lt;br&gt;UC-03 → US-004&lt;br&gt;UC-04 → US-005 · UC-05 → US-007&lt;br&gt;UC-06 → US-006, US-009 · UC-07 → US-010&lt;br&gt;UC-08 → EC-08 · UC-09 → US-006, US-008&lt;br&gt;UC-10 → US-011, US-012, US-015&lt;br&gt;UC-11 → US-013, US-016 · UC-12 → US-014&lt;br&gt;UC-13 → US-017 · UC-14 → US-018&lt;br&gt;UC-15 → UI-07 · UC-16, UC-17 → US-019&lt;br&gt;UC-18 → US-020 · UC-19 → US-022&lt;br&gt;&lt;br&gt;&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;Ô xanh: use case người dùng khởi tạo trực tiếp&lt;br&gt;Ô vàng: use case được include / mở rộng (extend)&lt;br&gt;Nét đứt xanh: «include» (bắt buộc)&lt;br&gt;Nét đứt đỏ: «extend» [điều kiện] (tùy chọn)&lt;br&gt;Mũi tên tam giác rỗng: tổng quát hóa" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#BFA94A;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1530" y="520" width="300" height="330" as="geometry"/></mxCell><mxCell id="note_roles" value="&lt;b&gt;Ghi chú vai trò&lt;/b&gt;&lt;br&gt;• Quản trị viên kế thừa mọi use case của Chuyên viên BD (BRU-006).&lt;br&gt;• UC-19 yêu cầu vai trò Admin theo BRU-006; Quản lý cần được cấp quyền này (chờ OQ-014).&lt;br&gt;• Tác nhân bên phải là tác nhân thứ cấp (hệ thống bên ngoài).&lt;br&gt;• Ghi nhận sự kiện sử dụng (US-021) là hành vi nội bộ, không phải use case." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#BFA94A;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1530" y="880" width="300" height="170" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Sơ đồ Use Case — Chat với tài liệu (MVP)&lt;/b&gt;&lt;br&gt;UML 2.x · Nguồn: PRD-CWD-001 v0.1 · 2026-10-20" style="text;html=1;align=left;verticalAlign=top;fontSize=13;" parent="1" vertex="1"><mxGeometry x="1530" y="20" width="320" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>