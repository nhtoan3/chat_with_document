<mxfile host="app.diagrams.net" type="device"><diagram id="ai" name="Xử lý job (worker)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ai_title" value="&lt;b&gt;Activity - Worker xử lý tài liệu: retry, ExtractionError, reclaim job treo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;v0.1 Draft 2026-11-02 · chưa review · as-built, phạm vi v0.4&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=14;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1100" height="40" as="geometry" /></mxCell><mxCell id="ai_lA" value="Vòng lặp worker (worker/main.py)" style="swimlane;startSize=30;horizontal=1;collapsible=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#D5E8D4;swimlaneFillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="400" height="1430" as="geometry" /></mxCell><mxCell id="ai_lB" value="Pipeline (worker/ingest.py)" style="swimlane;startSize=30;horizontal=1;collapsible=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#D5E8D4;swimlaneFillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="680" height="1430" as="geometry" /></mxCell><mxCell id="ai_lC" value="Hàng đợi (job_queue.py trên PostgreSQL)" style="swimlane;startSize=30;horizontal=1;collapsible=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#D5E8D4;swimlaneFillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1130" y="70" width="400" height="1430" as="geometry" /></mxCell><mxCell id="ai_ini" value="" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="ai_lA"><mxGeometry x="186" y="45" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_a0" value="Khởi tạo: get_engine, S3Storage, TEIEmbedding(timeout_s=30.0), last_stale_check = 0" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lA"><mxGeometry x="55" y="95" width="290" height="60" as="geometry" /></mxCell><mxCell id="ai_c_in" value="A" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="ai_lA"><mxGeometry x="35" y="181" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_m0" value="" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lA"><mxGeometry x="182" y="177" width="36" height="36" as="geometry" /></mxCell><mxCell id="ai_d0" value="stop.is_set()?&lt;br&gt;(SIGTERM / SIGINT)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lA"><mxGeometry x="115" y="240" width="170" height="84" as="geometry" /></mxCell><mxCell id="ai_fin" value="" style="ellipse;shape=endState;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="ai_lA"><mxGeometry x="345" y="268" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_d1" value="Quá STALE_CHECK_EVERY_S&lt;br&gt;(60 s) từ lần trước?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lA"><mxGeometry x="95" y="355" width="210" height="90" as="geometry" /></mxCell><mxCell id="ai_m1" value="" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lA"><mxGeometry x="182" y="490" width="36" height="36" as="geometry" /></mxCell><mxCell id="ai_d2" value="job is None?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lA"><mxGeometry x="125" y="650" width="150" height="76" as="geometry" /></mxCell><mxCell id="ai_wt" value="wait_for(stop.wait(), timeout = worker_poll_s = 2.0 s)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lA"><mxGeometry x="95" y="770" width="240" height="54" as="geometry" /></mxCell><mxCell id="ai_c_w" value="A" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="ai_lA"><mxGeometry x="35" y="783" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_rc" value="&lt;b&gt;reclaim_stale_jobs&lt;/b&gt;(conn, 10)&lt;br&gt;job 'running' có started_at quá 10 phút → state='retrying', next_run_at=now()" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lC"><mxGeometry x="20" y="355" width="320" height="90" as="geometry" /></mxCell><mxCell id="ai_cl" value="&lt;b&gt;claim_job&lt;/b&gt;: FOR UPDATE SKIP LOCKED, job 'queued' | 'retrying' đến hạn → state='running', started_at=now(), attempt+1; documents.status='processing' (trừ khi đã 'ready')" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lC"><mxGeometry x="15" y="530" width="330" height="96" as="geometry" /></mxCell><mxCell id="ai_sel" value="SELECT filename, storage_key FROM documents" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lB"><mxGeometry x="130" y="660" width="280" height="54" as="geometry" /></mxCell><mxCell id="ai_d3" value="doc is None?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lB"><mxGeometry x="195" y="745" width="150" height="70" as="geometry" /></mxCell><mxCell id="ai_try" value="«structured» try (ingest.py:51-57)" style="rounded=1;arcSize=2;dashed=1;container=1;collapsible=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=8;fontSize=10;fontStyle=2;fillColor=#F7F9FC;strokeColor=#8FA3BF;" vertex="1" parent="ai_lB"><mxGeometry x="50" y="840" width="440" height="370" as="geometry" /></mxCell><mxCell id="ai_g1" value="storage.get_bytes(storage_key)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_try"><mxGeometry x="80" y="30" width="280" height="40" as="geometry" /></mxCell><mxCell id="ai_g2" value="extract(pdf_bytes, pdf_max_pages = 300)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_try"><mxGeometry x="80" y="90" width="280" height="40" as="geometry" /></mxCell><mxCell id="ai_g3" value="chunker(pages, filename) = chunk_pages" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_try"><mxGeometry x="80" y="150" width="280" height="40" as="geometry" /></mxCell><mxCell id="ai_d4" value="doc_chunks rỗng?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_try"><mxGeometry x="145" y="208" width="150" height="66" as="geometry" /></mxCell><mxCell id="ai_g4" value="embedder.embed([c.embed_text ...])" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_try"><mxGeometry x="80" y="308" width="280" height="40" as="geometry" /></mxCell><mxCell id="ai_st" value="Transaction: DELETE chunks → INSERT chunks + embedding → documents.status='ready', pages, ready_at → job_queue.mark_succeeded (state='succeeded')" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lB"><mxGeometry x="100" y="1235" width="340" height="72" as="geometry" /></mxCell><mxCell id="ai_d6" value="Exception trong&lt;br&gt;transaction?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lB"><mxGeometry x="195" y="1325" width="150" height="74" as="geometry" /></mxCell><mxCell id="ai_m5" value="" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lB"><mxGeometry x="562" y="930" width="36" height="36" as="geometry" /></mxCell><mxCell id="ai_d5" value="job.attempt &amp;lt;&lt;br&gt;ingest_max_attempts&lt;br&gt;(= 3)?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="ai_lB"><mxGeometry x="495" y="990" width="170" height="90" as="geometry" /></mxCell><mxCell id="ai_mis" value="UPDATE ingestion_jobs: state='failed', error='document_missing'" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lC"><mxGeometry x="45" y="750" width="270" height="60" as="geometry" /></mxCell><mxCell id="ai_mfx" value="&lt;b&gt;mark_failed&lt;/b&gt;(job, exc.code)&lt;br&gt;job 'failed'; documents 'failed',&lt;br&gt;error_code = corrupted | encrypted_pdf&lt;br&gt;| too_many_pages | no_text_layer" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lC"><mxGeometry x="45" y="835" width="270" height="90" as="geometry" /></mxCell><mxCell id="ai_mrt" value="&lt;b&gt;mark_retrying&lt;/b&gt;: state='retrying',&lt;br&gt;next_run_at = now() + retry_delay(attempt)&lt;br&gt;= 10 s (lần 1), 40 s (lần 2); documents 'queued'" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lC"><mxGeometry x="45" y="990" width="270" height="90" as="geometry" /></mxCell><mxCell id="ai_mfe" value="&lt;b&gt;mark_failed&lt;/b&gt;(job, &quot;transient_exhausted&quot;)&lt;br&gt;job 'failed'; documents 'failed'" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="ai_lC"><mxGeometry x="45" y="1125" width="270" height="70" as="geometry" /></mxCell><mxCell id="ai_c1" value="A" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="ai_lC"><mxGeometry x="330" y="766" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_c2" value="A" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="ai_lC"><mxGeometry x="330" y="866" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_c3" value="A" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="ai_lC"><mxGeometry x="330" y="1021" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_c4" value="A" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="ai_lC"><mxGeometry x="330" y="1146" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_c5" value="A" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="ai_lB"><mxGeometry x="30" y="1348" width="28" height="28" as="geometry" /></mxCell><mxCell id="ai_d4x" value="raise&lt;br&gt;ExtractionError&lt;br&gt;(&quot;no_text_layer&quot;)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="ai_try"><mxGeometry x="325" y="214" width="108" height="54" as="geometry" /></mxCell><mxCell id="ai_n0" value="&lt;b&gt;Quy ước&lt;/b&gt;&lt;br&gt;(A) = connector: quay về đầu vòng lặp while.&lt;br&gt;Cạnh đỏ = rẽ nhánh do exception.&lt;br&gt;Không có fork / join: mỗi worker xử lý tuần tự một job; song song đến từ 2 replica và SKIP LOCKED." style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=10;fillColor=#FFFBE6;strokeColor=#B7A36B;" vertex="1" parent="1"><mxGeometry x="1570" y="70" width="300" height="104" as="geometry" /></mxCell><mxCell id="ai_n1" value="&lt;b&gt;Trạng thái&lt;/b&gt;&lt;br&gt;job_state: queued → running → succeeded | retrying | failed; retrying → running&lt;br&gt;document_status: queued → processing → ready | failed; processing → queued khi retry" style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=10;fillColor=#FFFBE6;strokeColor=#B7A36B;" vertex="1" parent="1"><mxGeometry x="1570" y="190" width="300" height="92" as="geometry" /></mxCell><mxCell id="ai_n2" value="&lt;b&gt;Reclaim không xét attempt&lt;/b&gt; (job_queue.py:27-32): job treo lặp lại được claim mãi, attempt có thể vượt 3; documents.status vẫn là 'processing' đến lần claim sau." style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=10;fillColor=#FFFBE6;strokeColor=#B7A36B;" vertex="1" parent="1"><mxGeometry x="1570" y="425" width="300" height="78" as="geometry" /></mxCell><mxCell id="ai_n3" value="&lt;b&gt;Không có handler chung&lt;/b&gt; (worker/main.py:37,46; ingest.py:58-65): exception khác nhóm đã liệt kê, hoặc lỗi DB ngoài các transaction được bọc, làm tiến trình worker thoát. Compose production có restart: unless-stopped; job còn 'running' đến khi reclaim." style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=10;fillColor=#FFFBE6;strokeColor=#B7A36B;" vertex="1" parent="1"><mxGeometry x="1570" y="730" width="300" height="106" as="geometry" /></mxCell><mxCell id="ai_n4" value="retry_delay = 10 × 4^(attempt-1) giây. Docstring ghi &quot;10 s, 40 s, 160 s&quot; nhưng với ingest_max_attempts = 3 lần thứ 3 thất bại là dừng, nên 160 s không xảy ra." style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=10;fillColor=#FFFBE6;strokeColor=#B7A36B;" vertex="1" parent="1"><mxGeometry x="1570" y="1060" width="300" height="78" as="geometry" /></mxCell><mxCell id="ai_n5" value="SIGTERM chỉ đặt cờ stop: job đang chạy luôn được làm xong (main.py:45)." style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=10;fillColor=#FFFBE6;strokeColor=#B7A36B;" vertex="1" parent="1"><mxGeometry x="1570" y="310" width="300" height="50" as="geometry" /></mxCell><mxCell id="ai_e1" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1" source="ai_ini" target="ai_a0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ai_e2" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=bl