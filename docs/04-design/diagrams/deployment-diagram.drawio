<mxfile host="app.diagrams.net" type="device"><diagram id="dp" name="Production AWS (chưa cấp phát)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="dp_title" value="&lt;b&gt;Deployment Diagram - Production trên AWS (theo infra/README.md, docker-compose.prod.yml)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;v0.1 Draft 2026-11-02 · chưa review · as-built, phạm vi v0.4&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=14;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1100" height="40" as="geometry" /></mxCell><mxCell id="dp_banner" value="&lt;b&gt;CHƯA CẤP PHÁT:&lt;/b&gt; tài nguyên AWS chưa được dựng (T-006 đang In progress). Trang này mô tả cấu hình dự kiến trong infra/README.md và infra/docker-compose.prod.yml, không phải môi trường đang chạy. Môi trường đang chạy thực tế là local: xem trang 2." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;spacingLeft=8;fontSize=11;fillColor=#F4CCCC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="50" y="62" width="1630" height="34" as="geometry" /></mxCell><mxCell id="dp_br" value="&lt;b&gt;«device» Trình duyệt&lt;/b&gt;&lt;br&gt;mạng công ty / VPN&lt;br&gt;(không đăng nhập)" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#DAE8FC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="170" height="90" as="geometry" /></mxCell><mxCell id="dp_xa" value="&lt;b&gt;«external»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;api.anthropic.com" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F5F5F5;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="190" height="120" as="geometry" /></mxCell><mxCell id="dp_xh" value="&lt;b&gt;«external»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Hugging Face Hub&lt;/b&gt;&lt;br&gt;BAAI/bge-m3" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F5F5F5;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="190" height="120" as="geometry" /></mxCell><mxCell id="dp_reg" value="«cloud» AWS - vùng ap-southeast-1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fillColor=#F7F3FA;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="270" y="115" width="1130" height="985" as="geometry" /></mxCell><mxCell id="dp_vpc" value="«network» VPC" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#9673A6;dashed=1;" vertex="1" parent="dp_reg"><mxGeometry x="20" y="35" width="780" height="930" as="geometry" /></mxCell><mxCell id="dp_pub" value="2 public subnet" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fillColor=#F7F9FC;strokeColor=#8FA3BF;dashed=1;" vertex="1" parent="dp_vpc"><mxGeometry x="20" y="35" width="210" height="620" as="geometry" /></mxCell><mxCell id="dp_alb" value="&lt;b&gt;«load balancer» ALB&lt;/b&gt;&lt;br&gt;443 (chứng chỉ ACM) → EC2:80&lt;br&gt;80 → redirect 443&lt;br&gt;idle timeout 120 s&lt;br&gt;health check /healthz" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#555555;" vertex="1" parent="dp_pub"><mxGeometry x="15" y="95" width="180" height="120" as="geometry" /></mxCell><mxCell id="dp_sga" value="&lt;b&gt;sg-alb&lt;/b&gt;: inbound 443 + 80 chỉ từ CIDR công ty. Không bao giờ mở 0.0.0.0/0" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F4CCCC;strokeColor=#B85450;" vertex="1" parent="dp_pub"><mxGeometry x="15" y="30" width="180" height="56" as="geometry" /></mxCell><mxCell id="dp_nat" value="&lt;b&gt;«gateway» NAT Gateway&lt;/b&gt;&lt;br&gt;EC2 ra Internet: gọi api.anthropic.com, tải model TEI" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#555555;" vertex="1" parent="dp_pub"><mxGeometry x="15" y="355" width="180" height="170" as="geometry" /></mxCell><mxCell id="dp_pri" value="2 private subnet" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fillColor=#F7F9FC;strokeColor=#8FA3BF;dashed=1;" vertex="1" parent="dp_vpc"><mxGeometry x="260" y="35" width="500" height="880" as="geometry" /></mxCell><mxCell id="dp_ec2" value="&lt;b&gt;«device» EC2&lt;/b&gt; m7i.2xlarge · Amazon Linux 2023 · EBS gp3 100 GB mã hóa&lt;br&gt;&lt;b&gt;sg-app&lt;/b&gt;: inbound 80 chỉ từ sg-alb; không mở SSH (SSM Session Manager)" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#DAE8FC;strokeColor=#555555;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="dp_pri"><mxGeometry x="15" y="30" width="470" height="620" as="geometry" /></mxCell><mxCell id="dp_af" value="«artifact»&lt;br&gt;docker-compose.prod.yml" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="dp_ec2"><mxGeometry x="20" y="60" width="145" height="48" as="geometry" /></mxCell><mxCell id="dp_ae" value="«artifact»&lt;br&gt;.env (mode 600)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="dp_ec2"><mxGeometry x="180" y="60" width="100" height="48" as="geometry" /></mxCell><mxCell id="dp_ad" value="«artifact»&lt;br&gt;deploy.sh, rollback.sh" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="dp_ec2"><mxGeometry x="320" y="60" width="130" height="48" as="geometry" /></mxCell><mxCell id="dp_cmp" value="«execution environment» Docker Compose" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fillColor=#EEF3FA;strokeColor=#6C8EBF;" vertex="1" parent="dp_ec2"><mxGeometry x="20" y="135" width="430" height="470" as="geometry" /></mxCell><mxCell id="dp_c_web" value="&lt;b&gt;«container» web&lt;/b&gt;&lt;br&gt;cwd-web:${TAG}&lt;br&gt;nginx, cổng 80:80&lt;br&gt;SPA + proxy /api, /healthz" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dp_cmp"><mxGeometry x="25" y="35" width="180" height="80" as="geometry" /></mxCell><mxCell id="dp_grp" value="x-backend: env_file .env, awslogs" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;fontStyle=2;fontSize=10;align=right;spacingRight=8;" vertex="1" parent="dp_cmp"><mxGeometry x="15" y="150" width="400" height="145" as="geometry" /></mxCell><mxCell id="dp_c_api" value="&lt;b&gt;«container» api&lt;/b&gt;&lt;br&gt;cwd-api:${TAG}&lt;br&gt;uvicorn --workers 2, cổng 8000" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dp_grp"><mxGeometry x="15" y="35" width="180" height="95" as="geometry" /></mxCell><mxCell id="dp_c_wrk" value="&lt;b&gt;«container» worker&lt;/b&gt;&lt;br&gt;cwd-api:${TAG}, replicas: 2&lt;br&gt;python -m app.worker.main" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dp_grp"><mxGeometry x="210" y="35" width="175" height="95" as="geometry" /></mxCell><mxCell id="dp_c_tei" value="&lt;b&gt;«container» tei&lt;/b&gt;&lt;br&gt;ghcr.io/huggingface/text-embeddings-inference:cpu-1.7&lt;br&gt;BAAI/bge-m3, giới hạn 3 CPU / 6g, volume tei-cache" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dp_cmp"><mxGeometry x="80" y="350" width="270" height="90" as="geometry" /></mxCell><mxCell id="dp_rds" value="&lt;b&gt;«database» RDS PostgreSQL 16&lt;/b&gt; + pgvector&lt;br&gt;db.t4g.medium · 50 GB gp3 · mã hóa KMS · backup 7 ngày · không public&lt;br&gt;&lt;b&gt;sg-db&lt;/b&gt;: inbound 5432 chỉ từ sg-app" style="shape=cylinder3;size=14;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="dp_pri"><mxGeometry x="15" y="715" width="470" height="140" as="geometry" /></mxCell><mxCell id="dp_s_sec" value="&lt;b&gt;«service» Secrets Manager&lt;/b&gt;&lt;br&gt;secret cwd/prod" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="dp_reg"><mxGeometry x="855" y="115" width="250" height="60" as="geometry" /></mxCell><mxCell id="dp_s_ecr" value="&lt;b&gt;«service» ECR&lt;/b&gt;&lt;br&gt;repository cwd-api, cwd-web" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="dp_reg"><mxGeometry x="855" y="225" width="250" height="60" as="geometry" /></mxCell><mxCell id="dp_s_clw" value="&lt;b&gt;«service» CloudWatch Logs&lt;/b&gt;&lt;br&gt;log group /cwd/prod" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="dp_reg"><mxGeometry x="855" y="385" width="250" height="60" as="geometry" /></mxCell><mxCell id="dp_s_s3" value="&lt;b&gt;«service» S3&lt;/b&gt; cwd-documents-prod&lt;br&gt;Block Public Access, SSE-KMS, versioning, bắt buộc TLS" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="dp_reg"><mxGeometry x="855" y="485" width="250" height="70" as="geometry" /></mxCell><mxCell id="dp_gh" value="&lt;b&gt;«external» GitHub Actions&lt;/b&gt;&lt;br&gt;CI build khi push main; OIDC role AWS_DEPLOY_ROLE_ARN" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F5F5F5;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1450" y="325" width="210" height="90" as="geometry" /></mxCell><mxCell id="dp_n1" value="&lt;b&gt;Lưu ý&lt;/b&gt;&lt;br&gt;· ALB giới hạn IP / VPN là lớp bảo vệ duy nhất vì MVP không có đăng nhập.&lt;br&gt;· Chỉ api và worker dùng driver awslogs; web và tei không gửi log lên CloudWatch.&lt;br&gt;· ANTHROPIC_API_KEY nằm trong .env dùng chung nên worker cũng có khóa, dù chỉ api gọi Anthropic.&lt;br&gt;· Migration: deploy.sh chạy alembic upgrade head qua container api.&lt;br&gt;· Đường đi tới các dịch vụ AWS (NAT hay VPC endpoint) không được nêu trong infra/README.md." style="shape=note;size=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=2;fontSize=10;fillColor=#FFFBE6;strokeColor=#B7A36B;" vertex="1" parent="1"><mxGeometry x="1450" y="700" width="230" height="260" as="geometry" /></mxCell><mxCell id="dp_e1" value="HTTPS 443" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.54167;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_br" target="dp_alb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dp_e2" value="HTTP 80" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.875;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_alb" target="dp_c_web"><mxGeometry relative="1" as="geometry" x="0.5"><Array as="points"><mxPoint x="535" y="385" /><mxPoint x="535" y="425" /></Array></mxGeometry></mxCell><mxCell id="dp_e3" value="HTTP 8000" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.47222;entryY=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_c_web" target="dp_c_api"><mxGeometry relative="1" as="geometry" x="-0.45" /></mxCell><mxCell id="dp_e4" value="HTTPS" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.57895;exitDx=0;exitDy=0;entryX=1;entryY=0.29412;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_c_api" target="dp_nat"><mxGeometry relative="1" as="geometry" x="0.2" /></mxCell><mxCell id="dp_e5" value="tải model" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.82353;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_c_tei" target="dp_nat"><mxGeometry relative="1" as="geometry" x="0.1"><Array as="points"><mxPoint x="542" y="745" /><mxPoint x="542" y="680" /></Array></mxGeometry></mxCell><mxCell id="dp_e6" value="HTTPS" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.29412;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_nat" target="dp_xa"><mxGeometry relative="1" as="geometry" x="0.2"><Array as="points"><mxPoint x="255" y="590" /><mxPoint x="255" y="560" /></Array></mxGeometry></mxCell><mxCell id="dp_e7" value="HTTPS" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.82353;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_nat" target="dp_xh"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="680" /><mxPoint x="255" y="720" /></Array></mxGeometry></mxCell><mxCell id="dp_e8" value="HTTP POST /embed :80" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.31481;entryY=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_c_api" target="dp_c_tei"><mxGeometry relative="1" as="geometry" x="-0.1" /></mxCell><mxCell id="dp_e9" value="HTTP POST /embed :80" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.7963;entryY=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open;endFill=0;endSize=8;" edge="1" parent="1" source="dp_c_wrk" target="dp_c_tei"><mxGeometry relative="1" as="geometry" x="-0.1" /></mxCell><mxCell id="dp_e10" value="PostgreSQL 5432 (ssl=require)" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.075;exitY=1;exitDx=0;exitDy=0;entryX=0.1383;entryY=0;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;endArrow=open