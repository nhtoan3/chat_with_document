ot;font-size:10px;color:#666666&quot;&gt;v0.1 Draft 2026-11-02 · chưa review · as-built, phạm vi v0.4&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;fontSize=14;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="15" width="1100" height="40" as="geometry" /></mxCell><mxCell id="dl_host" value="&lt;b&gt;«device» Máy developer&lt;/b&gt; - Docker Desktop (≥ 8 GB RAM), compose project chat-with-document" style="shape=cube;size=10;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fillColor=#DAE8FC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="900" height="560" as="geometry" /></mxCell><mxCell id="dl_bw" value="&lt;b&gt;«device» Trình duyệt&lt;/b&gt;&lt;br&gt;localhost:5173" style="shape=cube;size=10;boundedLbl=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#DAE8FC;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="180" height="80" as="geometry" /></mxCell><mxCell id="dl_xq" value="&lt;b&gt;«external»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;không có khóa → 503 ai_unavailable" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#F5F5F5;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="210" height="130" as="geometry" /></mxCell><mxCell id="dl_l_web" value="&lt;b&gt;«container» web&lt;/b&gt;&lt;br&gt;node:20-alpine, Vite dev :5173&lt;br&gt;VITE_API_PROXY=http://api:8000" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dl_host"><mxGeometry x="30" y="70" width="220" height="80" as="geometry" /></mxCell><mxCell id="dl_l_api" value="&lt;b&gt;«container» api&lt;/b&gt;&lt;br&gt;build ./backend, uvicorn --reload&lt;br&gt;cổng 8000:8000" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dl_host"><mxGeometry x="30" y="220" width="220" height="80" as="geometry" /></mxCell><mxCell id="dl_l_wrk" value="&lt;b&gt;«container» worker&lt;/b&gt;&lt;br&gt;build ./backend, replicas: 2&lt;br&gt;python -m app.worker.main" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dl_host"><mxGeometry x="340" y="220" width="220" height="80" as="geometry" /></mxCell><mxCell id="dl_l_mig" value="&lt;b&gt;«container» migrate&lt;/b&gt;&lt;br&gt;alembic upgrade head&lt;br&gt;(chạy một lần)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dl_host"><mxGeometry x="650" y="70" width="220" height="80" as="geometry" /></mxCell><mxCell id="dl_l_tei" value="&lt;b&gt;«container» tei&lt;/b&gt;&lt;br&gt;TEI cpu-1.7, linux/amd64, BAAI/bge-m3&lt;br&gt;--max-batch-tokens 2048, cổng 8080:80, volume tei-cache" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="dl_host"><mxGeometry x="30" y="410" width="250" height="90" as="geometry" /></mxCell><mxCell id="dl_l_s3" value="&lt;b&gt;«container» s3&lt;/b&gt;&lt;br&gt;adobe/s3mock, cổng 9090:9090&lt;br&gt;bucket cwd-documents-local, volume s3data" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="dl_host"><mxGeometry x="325" y="410" width="250" height="90" as="geometry" /></mxCell><mxCell id="dl_l_pg" value="&lt;b&gt;«container» postgres&lt;/b&gt;&lt;br&gt;pgvector/pgvector:pg16, cổng 5432:5432&lt;br&gt;volume pgdata" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="dl_host"><mxGeometry x="620" y="410" width="250" height="90" 