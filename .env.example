# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
QA_TOP_N=12

# Only needed when running the backend outside Docker (make test, make eval)
DATABASE_URL=postgresql+asyncpg://cwd:cwd@localhost:5432/cwd
S3_BUCKET=cwd-documents-local
S3_ENDPOINT_URL=http://localhost:9090
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
TEI_URL=http://localhost:8080
UPLOAD_MAX_MB=20
UPLOAD_MAX_FILES=10
PDF_MAX_PAGES=300
COLLECTION_MAX_DOCS=50
